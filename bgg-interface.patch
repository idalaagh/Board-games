+// ── BGG game import (authenticated Firebase callable; API token stays server-side) ──
+var bggFunctionsSdk = null;
+async function fetchBGGDetails(bggId) {
+  if (!window.BOARD_FIREBASE || !window.firebase) {
+    throw new Error('الاستيراد التلقائي يحتاج اتصال Firebase.');
+  }
+  if (!bggFunctionsSdk) {
+    bggFunctionsSdk = new Promise(function(resolve,reject) {
+      var script = document.createElement('script');
+      script.src = 'https://www.gstatic.com/firebasejs/12.4.0/firebase-functions-compat.js';
+      script.onload = resolve;
+      script.onerror = function() { reject(new Error('تعذّر تحميل خدمة الاستيراد.')); };
+      document.head.appendChild(script);
+    }).catch(function(error) { bggFunctionsSdk = null; throw error; });
+  }
+  await bggFunctionsSdk;
+  try {
+    var app = firebase.app('board-game-family');
+    var result = await app.functions('europe-west1').httpsCallable('bggGame')({id:bggId});
+    if (!result.data || !result.data.name) throw new Error('لم نجد بيانات لهذه اللعبة في BGG.');
+    return result.data;
+  } catch(error) {
+    if (error.code === 'functions/unauthenticated' || error.code === 'functions/permission-denied')
+      throw new Error('سجّلي الدخول بحساب مسموح له بالتعديل لاستيراد الألعاب.');
+    if (error.code === 'functions/unavailable' || error.code === 'functions/not-found')
+      throw new Error('خدمة استيراد BGG لم تُفعّل بعد.');
+    throw new Error(error.message || 'تعذّر الاتصال بـBGG. حاولي مرة أخرى.');
+  }
+}
