+// ── No-key game lookup: existing catalog, then CC0-licensed Wikidata ─────────
+// BGG links are used as identifiers only; this never calls BGG's restricted API.
+function gameNameFromBGGLink(link) {
+  try {
+    var parts = new URL(link).pathname.split('/').filter(Boolean);
+    if (parts.length < 3) return '';
+    return decodeURIComponent(parts.slice(2).join(' '))
+      .replace(/[-_]+/g,' ').replace(/\s+/g,' ').trim()
+      .replace(/\b[a-z]/g,function(ch){return ch.toUpperCase();}).slice(0,160);
+  } catch (_) { return ''; }
+}
