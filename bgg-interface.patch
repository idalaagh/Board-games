+function parseBGGLink(raw) {
+  try {
+    var url = new URL(raw.trim());
+    if (url.protocol !== 'https:' || !/^(www\.)?boardgamegeek\.com$/i.test(url.hostname)) return null;
+    var match = url.pathname.match(/^\/(?:boardgame|boardgameexpansion)\/(\d+)(?:\/|$)/i);
+    var id = match ? Number(match[1]) : 0;
+    return Number.isSafeInteger(id) && id > 0 ? id : null;
+  } catch(e) { return null; }
+}
